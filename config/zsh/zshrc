# >>> lig pre >>>
eval "$("/opt/homebrew/opt/lig/bin/lig" init zsh pre)"
# <<< lig pre <<<
# bash compatible
export PATH=$HOME/bin:$PATH

# add crates to path
export PATH=$PATH:/Users/mkrisher/.cargo/bin

# uses neovim
export EDITOR=nvim

# Adds sbin for homebrew
export PATH="/opt/homebrew/bin:/usr/local/sbin:$PATH"

if type brew &>/dev/null; then
  # note, permissions error when linking formulas
  FPATH=$(brew --prefix)/share/zsh/site-functions:$FPATH

  autoload -Uz compinit
  compinit
fi

# Set name of the theme to load
ZSH_THEME="apple"

source "$HOME/.cargo/env" # rust package manager

# load environment specific files
source ~/.config/.env 
source ~/.config/.aliases

# mimic os x keys for start and end of line
# which don't conflict with tmux keys, requires preferences in iterm
bindkey "[D" backward-word
bindkey "[C" forward-word
bindkey "^[a" beginning-of-line
bindkey "^[e" end-of-line

eval "$(zoxide init zsh)"

eval "$(ssh-agent -s)"

# puts tailwind ahead of rbenv shim
export PATH="/usr/local/bin:$PATH"

# The next line updates PATH for the Google Cloud SDK.
if [ -f '/Users/mkrisher/google-cloud-sdk/path.zsh.inc' ]; then . '/Users/mkrisher/google-cloud-sdk/path.zsh.inc'; fi

# The next line enables shell command completion for gcloud.
if [ -f '/Users/mkrisher/google-cloud-sdk/completion.zsh.inc' ]; then . '/Users/mkrisher/google-cloud-sdk/completion.zsh.inc'; fi

eval "$(starship init zsh)"

# uv-managed python and tools; ahead of Homebrew so uv's python wins
export PATH="$HOME/.local/bin:$PATH"
export PATH="/opt/homebrew/opt/llvm/bin:$PATH"

# For compilers to find llvm you may need to set:
export LDFLAGS="-L/opt/homebrew/opt/llvm/lib"
export CPPFLAGS="-I/opt/homebrew/opt/llvm/include"
eval "$(mise activate zsh)"

# loads per-project devenv environments (see .envrc in each project)
command -v direnv >/dev/null && eval "$(direnv hook zsh)"

# bun completions
[ -s "/Users/mkrisher/.bun/_bun" ] && source "/Users/mkrisher/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Pi
export PATH="/Users/mkrisher/.local/share/mise/installs/node/26.9.0/bin:$PATH"

# yazi
function y() {
	local tmp cwd; tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd" || builtin true
	command rm -f -- "$tmp"
}
# >>> lig post >>>
eval "$("/opt/homebrew/opt/lig/bin/lig" init zsh post)"
# <<< lig post <<<

# Rex ships its `rex` CLI inside the app bundle and only exports REX_BIN_DIR.
# Put it on PATH so tools that spawn plain `rex` (e.g. pi-rex-btw) can find it.
[[ -n "$REX_BIN_DIR" && -d "$REX_BIN_DIR" ]] && export PATH="$PATH:$REX_BIN_DIR"

# Rex project layouts (config/rex/projects.lua) start panes with REX_RUN set.
# Type it into the first prompt, after direnv/devenv has loaded, as if typed.
if [[ -n "$REX_RUN" ]]; then
  _rex_run_once() {
    add-zle-hook-widget -d zle-line-init _rex_run_once
    local cmd=$REX_RUN
    unset REX_RUN
    zle -U "$cmd"$'\n'
  }
  autoload -Uz add-zle-hook-widget
  zle -N _rex_run_once
  add-zle-hook-widget zle-line-init _rex_run_once
fi
